[Unit]
Description=AYANEO 3 fan control
After=systemd-modules-load.service systemd-udev-trigger.service
ConditionPathExists=/sys/devices/platform/ayaneo-ec
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=root
Group=bazzite
RuntimeDirectory=ay3-fancontrol
RuntimeDirectoryMode=0755
StateDirectory=ay3-fancontrol
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /var/lib/ay3-fancontrol/app/ay3_fancontrol.py
ExecStopPost=/usr/bin/python3 /var/lib/ay3-fancontrol/app/ay3_fancontrol.py --restore-auto
Restart=on-failure
RestartSec=2
WatchdogSec=8
WatchdogSignal=SIGKILL
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/sys
ReadWritePaths=/sys/devices/platform/ayaneo-ec/hwmon
ReadWritePaths=/var/lib/ay3-fancontrol /run/ay3-fancontrol
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
